# Copia este archivo como .env y llena los valores reales.
# .env NUNCA se sube a GitHub (está en .gitignore).

PORT=3000
NODE_ENV=production

# Base de datos (en Docker Compose el host es "db")
DB_USER=usuario
DB_PASSWORD=cambia_esta_clave
DB_NAME=mi_app
DATABASE_URL=postgres://usuario:cambia_esta_clave@db:5432/mi_app

# JWT — generar con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=reemplazar_por_cadena_aleatoria_larga
JWT_EXPIRES_IN=1h

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173
